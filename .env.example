# ---------------- Scavenge configuration ----------------
PORT=8080
# SCAVENGE_DEMO=1                  # offline simulator instead of live feeds
# SCAVENGE_TOKEN=change-me         # require "Authorization: Bearer <token>" for write API calls
# SCAVENGE_USER_AGENT=Scavenge/1.0 (you@example.com)   # some APIs (Reddit) like a contact in the UA

# Poll intervals (seconds)
POLL_SOCIAL_SEC=90
POLL_EVENTS_SEC=300
POLL_WEATHER_SEC=900

# ---------------- Free, keyless (on by default) ----------------
# Reddit, Mastodon, Hacker News, GDELT world news, USGS quakes, NASA EONET, Open-Meteo, NASA GIBS
MASTODON_INSTANCE=mastodon.social

# ---------------- Free with a key ----------------
# BSKY_HANDLE=you.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx      # bsky.app → Settings → App passwords
# YOUTUBE_API_KEY=                            # Google Cloud console, YouTube Data API v3

# ---------------- Platforms that require official API access ----------------
# X_BEARER_TOKEN=                             # developer.x.com — plan with recent-search
# FB_ACCESS_TOKEN=                            # Meta Graph API token
# FB_PAGE_IDS=pageid1,pageid2                 # public pages to monitor
# LINKEDIN_TOKEN=                             # LinkedIn Community Management API
# LINKEDIN_ORG_URNS=urn:li:organization:12345

# ---------------- Radio & emergencies ----------------
# Emergency feeds (aircraft squawks via adsb.lol, GDACS, US NWS) are free and on by default.
POLL_AIRCRAFT_SEC=60

# Local receiver: install rtl-sdr (rtl_fm) + ffmpeg and plug in an RTL-SDR dongle.
# SDR_LAT=-4.04                      # receiver position, puts heard calls on the map
# SDR_LON=39.67
# SDR_VOX_LEVEL=600                  # audio level that counts as a transmission
# SDR_EXTRA_ARGS=-E direct2          # HF (below 24 MHz) with a direct-sampling dongle

# Speech-to-text for received calls (any OpenAI-compatible /audio/transcriptions endpoint,
# e.g. a free local faster-whisper server). Enables automatic MAYDAY / PAN-PAN detection.
# TRANSCRIBE_URL=http://localhost:8000/v1
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=

# On-air talk-back — LICENSED OPERATORS ONLY. Keys your own transceiver via Hamlib rigctld.
# TX_ENABLED=1
# TX_CALLSIGN=5Z4XXX                 # your licensed call sign
# TX_PIN=choose-a-long-pin           # required on every transmission (min 6 characters)
# TX_ALLOWED_RANGES=144-146,430-440  # MHz ranges your licence covers (default: amateur bands)
# TX_MARINE_LICENSED=1               # only if you hold a marine station licence (unlocks Ch16 / 2182 kHz)
# TX_PTT=rigctld                     # or "vox"
# RIGCTLD_HOST=127.0.0.1
# RIGCTLD_PORT=4532
# TX_AUDIO_DEVICE=default            # ALSA device wired to the radio's mic/data input
# TX_MAX_SECONDS=60
# Aviation (108–137 MHz), 243 MHz guard and 406 MHz beacon frequencies are always refused.

# ---------------- Optional LLM for AI briefings (any OpenAI-compatible endpoint) ----------------
# Free local option: install Ollama, `ollama pull llama3.1`, then:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=                                # for hosted endpoints (Groq, OpenRouter…)
